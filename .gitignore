# Delphi build products and IDE-local settings
*.~*
__history/
__recovery/

*.dcu
*.dcp
*.obj
*.local
*.identcache
*.exe
*.rsm
*.map
*.tds
*.dsk

Debug/
Release/
Win32/
Win64/

.DS_Store

# The application resource is required; smoke-test/tool resources are generated.
/Tests/*.res
/Tools/*.res

# Generated test, inspection and AI exchange data stay local.
/Tests/output/
/Analysis/results/
/Exchange/
/PSD/

# Keep reusable records in Git, while PSDs, images, session responses,
# snapshots and one-off preparation scripts remain local.
/Sample/**
!/Sample/**/
!/Sample/**/README.md
!/Sample/**/learning_record.json
!/Sample/**/*prompt*.json
!/Sample/**/verification.json

# Python caches and temporary files
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.tmp
*.log
